# ============================================================
# Synapse AI — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it is listed in .gitignore.
# ============================================================

# ----- LLM Provider Selection -----
# Options: "mock" (default, offline), "gemini" (cloud API), "ollama" (local)
SYNAPSE_LLM_PROVIDER=mock

# ----- Gemini API Configuration -----
# Get your free API key at: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-api-key-here
# SYNAPSE_GEMINI_MODEL=gemini-3.5-flash-lite
# SYNAPSE_GEMINI_TIMEOUT=60
# SYNAPSE_GEMINI_STORE=false

# ----- Ollama Configuration (Local LLM) -----
# SYNAPSE_OLLAMA_MODEL=llama3.2
# SYNAPSE_OLLAMA_HOST=http://localhost:11434
# SYNAPSE_OLLAMA_TIMEOUT=60

# ----- Security -----
# REQUIRED for production: Set to a secure random string (min 32 chars)
# python -c "import secrets; print(secrets.token_urlsafe(64))"
# SYNAPSE_SECRET_KEY=your-secure-random-string-here

# ----- CORS -----
# Comma-separated list of allowed origins (production)
# SYNAPSE_ALLOWED_ORIGINS=https://lifecare.example.com
# SYNAPSE_ALLOW_ALL_ORIGINS=false

# ----- Database -----
# Default: data/synapse_wallet.db (SQLite)
# SYNAPSE_DB_PATH=data/synapse_wallet.db
